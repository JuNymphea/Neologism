# Training outputs: the trained vectors (12 KB each) and the generations are the
# result and are tracked. The tokenizer is not -- it is 33 MB of base tokenizer with
# one token added, and training writes it on first run.
scripts/train/results/*/tokenizer/
# the shared tokenizer every results dir gets: results_*/<model>/<token>/tokenizer
scripts/train/results*/*/*/tokenizer/
checkpoints-*/

# local model weights
model/

# scratch
scripts/try.py

# python
__pycache__/
*.py[cod]
.venv/
venv/

# logs
swanlog/
wandb/

# macOS
.DS_Store

# generated by setup_env.sh, machine-specific
scripts/train/env.sh

# job logs
logs/

# LM-judge reply cache: hundreds of MB of pickles
scripts/eval/cached_data/
