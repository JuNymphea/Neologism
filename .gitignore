# Training outputs: the trained vectors (12 KB each) and the generations are the
# result and are tracked. The tokenizer saved beside each one is a 32 MB copy of the
# base tokenizer, byte-identical for every run -- 4.7 GB across the 151 runs.
scripts/train/checkpoints/*/tokenizer/
checkpoints-*/

# local model weights
model/

# scratch
scripts/try.py

# python
__pycache__/
*.py[cod]
.venv/
venv/

# logs
swanlog/
wandb/

# macOS
.DS_Store

# generated by setup_env.sh, machine-specific
scripts/train/env.sh

# job logs
logs/
